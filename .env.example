# Conexión a MongoDB Atlas (ver guía de configuración)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=the_creator_garden

# Credenciales de acceso al panel /admin
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=escribe-aqui-tu-contraseña-simple

# Secreto para firmar las sesiones de admin (cualquier string largo y aleatorio).
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
